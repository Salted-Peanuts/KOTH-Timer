//// ===== Battery calibration =====
// Final two-point calibration using ONLY the ESP32's own analogReadMilliVolts()
// value reported as "ba0" in /state.
//
// Both points were measured with the KOTH powered normally and the battery
// voltage measured under load.
//
// Measured points:
//   /state ba0 1.81V -> actual battery 3.39V
//   /state ba0 2.18V -> actual battery 4.09V
//
// Derived linear fit:
//   battery_V ≈ -0.034324 + (1.891892 * A0_V)
static const float CAL_A0_LOW    = 1.81f;
static const float CAL_BATT_LOW  = 3.39f;
static const float CAL_A0_HIGH   = 2.18f;
static const float CAL_BATT_HIGH = 4.09f;

// Optional final trim. Leave at defaults unless recalibrating against a meter.
static const float BATT_GAIN   = 1.000f;
static const float BATT_OFFSET = 0.000f;

//// ===== Battery smoothing knobs =====
// Stronger smoothing is useful because the calibrated A0 span is small.
static const float EMA_ALPHA = 0.05f;
static const uint32_t BATT_UPDATE_MS = 1000;
static const int BATT_SAMPLES = 16;

//// ===== Debounce =====
struct DebouncedButton {
  int pin;
  bool stable;      // HIGH not pressed, LOW pressed
  bool lastReading;
  uint32_t lastChangeMs;
};
static const uint32_t DEBOUNCE_MS = 25;

static DebouncedButton btnA  {PIN_BTN_A,   true, true, 0};
static DebouncedButton btnB  {PIN_BTN_B,   true, true, 0};
static DebouncedButton btnBt {PIN_BTN_BAT, true, true, 0};

static inline void readDebounced(DebouncedButton &b) {
  bool r = digitalRead(b.pin);
  if (r != b.lastReading) {
    b.lastReading = r;
    b.lastChangeMs = millis();
  }
  if (millis() - b.lastChangeMs > DEBOUNCE_MS) {
    b.stable = r;
  }
}
static inline bool isPressed(const DebouncedButton &b) { return b.stable == LOW; }

