</div>

<script>
let ws = null;
let lastStateAt = 0;
let wsWanted = true;

// Prevent live state polling from overwriting a value while the referee edits it.
let minsDirty = false;
let colADirty = false;
let colBDirty = false;

const el = (id) => document.getElementById(id);

window.addEventListener("load", function(){
  el("mins").addEventListener("input", function(){ minsDirty = true; });
  el("colA").addEventListener("input", function(){ colADirty = true; });
  el("colB").addEventListener("input", function(){ colBDirty = true; });
});

function setConn(text, good){
  const p = el("connPill");
  p.textContent = text;
  p.className = "pill " + (good ? "good" : "bad");
}

function hexToRgb(hex){
  const h = (hex || "").replace("#","").trim();
  if(h.length !== 6) return null;
  const n = parseInt(h, 16);
  if(Number.isNaN(n)) return null;
  return {r:(n>>16)&255,g:(n>>8)&255,b:n&255};
}

function rgbToHsl(r,g,b){
  r/=255; g/=255; b/=255;
  const max=Math.max(r,g,b), min=Math.min(r,g,b);
  let h=0, s=0, l=(max+min)/2;
  const d=max-min;
  if(d){
    s=d/(1-Math.abs(2*l-1));
    if(max===r) h=((g-b)/d)%6;
    else if(max===g) h=(b-r)/d+2;
    else h=(r-g)/d+4;
    h*=60;
    if(h<0) h+=360;
  }
  return {h,s,l};
}

function teamName(hex){
  const rgb = hexToRgb(hex);
  if(!rgb) return "Team";
  const hsl = rgbToHsl(rgb.r,rgb.g,rgb.b);
  if(hsl.s < 0.18 || hsl.l < 0.12 || hsl.l > 0.92) return "Neutral Team";
  const h = hsl.h;
  if(h < 15 || h >= 345) return "Red Team";
  if(h < 45) return "Orange Team";
  if(h < 70) return "Yellow Team";
  if(h < 160) return "Green Team";
  if(h < 200) return "Cyan Team";
  if(h < 255) return "Blue Team";
  if(h < 300) return "Purple Team";
  return "Pink Team";
}

function contrastText(hex){
  const rgb = hexToRgb(hex);
  if(!rgb) return "#ffffff";
  // Perceived brightness. Black text is easier on bright yellow/green/orange.
  const brightness = (rgb.r * 299 + rgb.g * 587 + rgb.b * 114) / 1000;
  return brightness > 155 ? "#061018" : "#ffffff";
}

function setColours(a,b){
  document.documentElement.style.setProperty("--a", a);
  document.documentElement.style.setProperty("--b", b);
  document.documentElement.style.setProperty("--aText", contrastText(a));
  document.documentElement.style.setProperty("--bText", contrastText(b));
  const nameA = teamName(a);
  const nameB = teamName(b);

  el("labelA").textContent = nameA;
  el("labelB").textContent = nameB;

  // Ref time-fix buttons use the selected colour names for fast event use.
  el("fixAPlus").textContent = nameA + " +";
  el("fixAMinus").textContent = nameA + " −";
  el("fixBPlus").textContent = nameB + " +";
  el("fixBMinus").textContent = nameB + " −";
}

function updateCards(d){
  const a = el("cardA");
  const b = el("cardB");
  a.classList.remove("active","done");
  b.classList.remove("active","done");
  el("stateA").textContent = "Ready";
  el("stateB").textContent = "Ready";

  if(d.status === "TEAM_A"){
    a.classList.add("active");
    el("stateA").textContent = "Capturing";
    el("stateB").textContent = "Defending";
  } else if(d.status === "TEAM_B"){
    b.classList.add("active");
    el("stateA").textContent = "Defending";
    el("stateB").textContent = "Capturing";
  } else if(d.status === "CONTESTED"){
    a.classList.add("active");
    b.classList.add("active");
    el("stateA").textContent = "Contested";
    el("stateB").textContent = "Contested";
  } else if(d.status === "DONE"){
    a.classList.add("done");
    b.classList.add("done");
    el("stateA").textContent = "Done";
    el("stateB").textContent = "Done";
  }
}

function updateStatus(d){
  const nameA = el("labelA").textContent || "Team A";
  const nameB = el("labelB").textContent || "Team B";
  let main = "Ready";
  let sub = "Waiting for game start";

  if(d.lowBatt && d.started){
    main = "LOW BATTERY — GAME FROZEN";
    sub = "Call FREEZE, replace the battery, then Resume when ready";
  } else if(d.lowBatt){
    main = "LOW BATTERY";
    sub = "Replace the battery before starting a match";
  } else if(d.recovery && d.started && d.paused){
    main = "Game recovered — paused";
    sub = "Saved scores restored. Resume when all players are ready";
  } else if(d.identify){
    main = "Identifying teams";
    sub = "Displays and LEDs are flashing";
  } else if(d.winner === "TEAM_A"){
    main = nameA + " wins!";
    sub = "Match complete";
  } else if(d.winner === "TEAM_B"){
    main = nameB + " wins!";
    sub = "Match complete";
  } else if(d.winner === "DRAW"){
    main = "Draw!";
    sub = "Match complete";
  } else if(d.paused){
    main = "Paused";
    sub = "Ref controls are available";
  } else if(!d.started){
    main = "Ready";
    sub = "Press Start to begin";
  } else if(d.status === "TEAM_A"){
    main = nameA + " capturing";
    sub = "Only Button A is held";
  } else if(d.status === "TEAM_B"){
    main = nameB + " capturing";
    sub = "Only Button B is held";
  } else if(d.status === "CONTESTED"){
    main = "Contested";
    sub = "Both buttons are held — no score";
  } else {
    main = "No capture";
    sub = "Hold one team button to score";
  }

  el("statusMain").textContent = main;
  el("statusSub").textContent = sub;
}

function updateUI(d){
  lastStateAt = Date.now();

  if(typeof d.a === "string") el("timeA").textContent = d.a;
  if(typeof d.b === "string") el("timeB").textContent = d.b;

  if(typeof d.colA === "string" && typeof d.colB === "string"){
    setColours(d.colA, d.colB);

    if(!colADirty && document.activeElement !== el("colA")) el("colA").value = d.colA;
    if(!colBDirty && document.activeElement !== el("colB")) el("colB").value = d.colB;
  }

  if(d.dur !== undefined){
    const mins = Math.round(Number(d.dur) / 60);
    if(Number.isFinite(mins) && !minsDirty && document.activeElement !== el("mins")){
      el("mins").value = mins;
    }
  }

  if(d.bp !== undefined && d.bv !== undefined){
    const bp = Number(d.bp);
    const bv = Number(d.bv);
    if(Number.isFinite(bp) && Number.isFinite(bv)){
      el("batt").textContent = Math.round(bp) + "% / " + bv.toFixed(2) + "V";
    }
  }

  const finished = d.winner === "TEAM_A" || d.winner === "TEAM_B" || d.winner === "DRAW";

  el("startBtn").disabled = !!d.started || !!d.lowBatt;
  el("pauseBtn").disabled = !d.started || !!d.paused || finished;
  el("resumeBtn").disabled = !d.started || !d.paused || !!d.lowBatt || finished;
  el("resetBtn").disabled = !(!!d.paused || finished);

  let stateLabel = (d.started ? "Started" : "Stopped") + (d.paused ? " / Paused" : "");
  if(d.recovery) stateLabel += " / Recovery saved";
  el("stateText").textContent = stateLabel;
  updateCards(d);
  updateStatus(d);
}

function connectWs(){
  if(!wsWanted) return;
  try{
    ws = new WebSocket("ws://" + location.hostname + ":81/");
  }catch(e){
    setTimeout(connectWs, 1500);
    return;
  }

  ws.onopen = function(){ setConn("Live", true); };
  ws.onmessage = function(ev){
    try{ updateUI(JSON.parse(ev.data)); }catch(e){}
  };
  ws.onerror = function(){ try{ ws.close(); }catch(e){} };
  ws.onclose = function(){
    setConn("Retrying", false);
    setTimeout(connectWs, 1500);
  };
}

function pollState(){
  fetch("/state", {cache:"no-store"})
    .then(r => r.json())
    .then(d => {
      updateUI(d);
      if(!ws || ws.readyState !== 1) setConn("Polling", true);
    })
    .catch(() => {
      if(Date.now() - lastStateAt > 3000) setConn("Offline", false);
    });
}

function cmd(c){
  fetch("/cmd?c=" + encodeURIComponent(c), {cache:"no-store"})
    .then(() => setTimeout(pollState, 120))
    .catch(() => {});
}

function applyDuration(){
  let m = parseInt(el("mins").value || "5", 10);
  if(!Number.isFinite(m)) m = 5;
  if(m < 1) m = 1;
  if(m > 60) m = 60;
  el("mins").value = m;
  fetch("/set?dur=" + encodeURIComponent(m), {cache:"no-store"})
    .then(() => {
      minsDirty = false;
      setTimeout(pollState, 120);
    })
    .catch(() => {});
}

function applyColors(){
  const a = el("colA").value;
  const b = el("colB").value;
  fetch("/set?colA=" + encodeURIComponent(a) + "&colB=" + encodeURIComponent(b), {cache:"no-store"})
    .then(() => {
      colADirty = false;
      colBDirty = false;
      setTimeout(pollState, 120);
    })
    .catch(() => {});
}

function quickSet(s){
  el("adjSecs").value = s;
}

function getAdjustSeconds(){
  let s = parseInt(el("adjSecs").value || "30", 10);
  if(!Number.isFinite(s)) s = 30;
  if(s < 1) s = 1;
  if(s > 600) s = 600;
  el("adjSecs").value = s;
  return s;
}

function adjustTime(team, delta){  fetch("/adjust?team=" + encodeURIComponent(team) + "&delta=" + encodeURIComponent(delta), {cache:"no-store"})
    .then(() => setTimeout(pollState, 120))
    .catch(() => {});
}

connectWs();
pollState();
setInterval(pollState, 1000);
</script>
</body>
</html>
)HTML";

static void handleSydneyNerfLogo() {
  server.sendHeader("Cache-Control", "public, max-age=86400");
  server.send_P(
    200,
    "image/webp",
    (const char*)SYDNEY_NERF_LOGO_WEBP,
    sizeof(SYDNEY_NERF_LOGO_WEBP)
  );
}

static void handlePCBWayLogo() {
  server.sendHeader("Cache-Control", "public, max-age=86400");
  server.send_P(
    200,
    "image/webp",
    (const char*)PCBWAY_LOGO_WEBP,
    sizeof(PCBWAY_LOGO_WEBP)
  );
}

static void sendNoCacheHeaders() {
  server.sendHeader("Cache-Control", "no-store, no-cache, must-revalidate, max-age=0");
  server.sendHeader("Pragma", "no-cache");
  server.sendHeader("Expires", "0");
}

static void handleRoot(){
  sendNoCacheHeaders();
  server.send_P(200, "text/html", INDEX_HTML);
}

static void handleConfig(){
  String json;
  json.reserve(96);
  json = "{";
  json += "\"dur\":" + String(durationSec) + ",";
  json += "\"colA\":\"" + colorA + "\",";
  json += "\"colB\":\"" + colorB + "\"}";

  sendNoCacheHeaders();
  server.send(200, "application/json", json);
}

static void handleNotFound(){
  sendNoCacheHeaders();
  server.send(
    404,
    "text/plain",
    "Not found. Join KOTH-Timer Wi-Fi and open http://10.10.10.1/"
  );
}

static void handlePing(){
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "text/plain", "KOTH Timer OK");
}

static void handleState(){
  sendNoCacheHeaders();
  server.send(200, "application/json", makeStateJson());
}

static void handleSet(){
  if(server.hasArg("dur")){
    int mins = server.arg("dur").toInt();
    if(mins < 1) mins = 1;
    if(mins > 60) mins = 60;
    durationSec = (uint32_t)mins * 60;
  }
  if(server.hasArg("colA")){
    String requested = server.arg("colA");
    if(!isValidHtmlColor(requested)){
      server.send(400, "text/plain", "Invalid Team A colour");
      return;
    }
    colorA = requested;
  }

  if(server.hasArg("colB")){
    String requested = server.arg("colB");
    if(!isValidHtmlColor(requested)){
      server.send(400, "text/plain", "Invalid Team B colour");
      return;
    }
    colorB = requested;
  }

  saveConfig();
  if(!started) {
    clearRecoveryState();
    resetTimers();
    rearmVictorySound();
  }
  server.send(200, "text/plain", "OK");
}

static void handleCmd(){
  String c = server.arg("c");

  if(c=="start"){
    if(!started && !lowBatteryCritical){
      manualStartSequenceActive = false;
      manualStartMatchStarted = false;
      bothButtonsHeldSinceMs = 0;

      clearRecoveryState();
      rearmVictorySound();
      started = true;
      paused  = false;
      lastTickMs = millis();
    }
  }
  else if(c=="pause"){
    if(started && !paused){
      paused = true;
    }
  }
  else if(c=="resume"){
    // A critical battery can never be manually overridden. After a battery
    // swap/reboot, the recovered match remains paused until this command.
    if(started && paused && !lowBatteryCritical){
      paused = false;
      clearRecoveryState();
      lastTickMs = millis();
    }
  }
  else if(c=="reset"){
    // Only allow reset if paused OR match finished
    if(paused || remainingA <= 0 || remainingB <= 0){
      manualStartSequenceActive = false;
      manualStartMatchStarted = false;
      bothButtonsHeldSinceMs = 0;

      resetTimers();
      clearRecoveryState();
      rearmVictorySound();
      started = false;
      paused  = false;
    }
  }
  else if(c=="identify" && !started){
    identifyMode = true;
    identifyUntilMs = millis() + 5000;
  }

  server.send(200, "text/plain", "OK");
}

static void handleAdjust(){
  if(!server.hasArg("team") || !server.hasArg("delta")){
    server.send(400, "text/plain", "Missing team or delta");
    return;
  }

  String team = server.arg("team");
  int32_t delta = server.arg("delta").toInt();

  // Safety clamp: one click/request can only adjust by up to 10 minutes.
  if(delta > 600) delta = 600;
  if(delta < -600) delta = -600;

  if(team != "A" && team != "B"){
    server.send(400, "text/plain", "Invalid team");
    return;
  }

  adjustTeamTime(team, delta);

  // If the admin corrects a battery-recovered game before resuming it,
  // update the emergency snapshot so another power interruption still
  // restores the corrected scores.
  if(recoverySnapshotValid && started && paused &&
     remainingA > 0 && remainingB > 0){
    saveRecoveryState();
  }

  // If time was added back after a match finished, normal loop logic will
  // leave DONE state on the next capture-state evaluation.
  broadcastState();

  server.send(200, "text/plain", "OK");
}

static void onWsEvent(uint8_t num, WStype_t type, uint8_t*, size_t){
  if(type == WStype_CONNECTED){
    String p = makeStateJson();
    ws.sendTXT(num, p);
  }
}

static void registerWebRoutes() {
  server.on("/", handleRoot);
  server.on("/config", handleConfig);
  server.on("/set", handleSet);
  server.on("/cmd", handleCmd);
  server.on("/adjust", handleAdjust);
  server.on("/ping", handlePing);
  server.on("/state", handleState);
  server.on("/sydney-nerf.webp", handleSydneyNerfLogo);
  server.on("/pcbway.webp", handlePCBWayLogo);
  server.onNotFound(handleNotFound);
}

static void startAdminWiFi(){
  WiFi.persistent(false);
  WiFi.mode(WIFI_OFF);
  delay(150);

  WiFi.mode(WIFI_AP);
  WiFi.setSleep(false);
  WiFi.setTxPower(WIFI_POWER_19_5dBm);

  bool configOK = WiFi.softAPConfig(AP_IP, AP_GATEWAY, AP_SUBNET);

  const char* pass = nullptr;
  if(strlen(AP_PASS) >= 8){
    pass = AP_PASS;
  }

  bool apOK = WiFi.softAP(
    AP_SSID,
    pass,
    AP_CHANNEL,
    AP_HIDDEN,
    AP_MAX_CLIENTS
  );

  delay(150);

  Serial.println();
  Serial.println("===== KOTH Timer Wi-Fi =====");
  Serial.print("Firmware: ");
  Serial.println(FIRMWARE_VERSION);
  Serial.print("AP config: ");
  Serial.println(configOK ? "OK" : "FAILED");
  Serial.print("AP started: ");
  Serial.println(apOK ? "YES" : "NO");
  Serial.print("SSID: ");
  Serial.println(AP_SSID);
  Serial.print("Admin page: http://");
  Serial.print(WiFi.softAPIP());
  Serial.println("/");
  if(strlen(AP_PASS) >= 8){
    Serial.print("Password: ");
    Serial.println(AP_PASS);
  } else {
    Serial.println("Password: open network");
  }
  Serial.println("============================");
}

//// ===== Setup/Loop =====
void setup(){
  Serial.begin(115200);
  delay(50);

  pinMode(PIN_BTN_A, INPUT_PULLUP);
  pinMode(PIN_BTN_B, INPUT_PULLUP);
  pinMode(PIN_BTN_BAT, INPUT_PULLUP);

  pinMode(PIN_LED_A, OUTPUT);
  pinMode(PIN_LED_B, OUTPUT);
  digitalWrite(PIN_LED_A, LOW);
  digitalWrite(PIN_LED_B, LOW);

  pinMode(PIN_BUZZER, OUTPUT);
  stopBuzzer();

  pinMode(PIN_BAR_RED, OUTPUT);
  pinMode(PIN_BAR_YELLOW, OUTPUT);
  pinMode(PIN_BAR_G1, OUTPUT);
  pinMode(PIN_BAR_G2, OUTPUT);
  pinMode(PIN_BAR_G3, OUTPUT);
  barAllOff();

  pinMode(PIN_BATT_ADC, INPUT);
  analogReadResolution(12);
  analogSetPinAttenuation(PIN_BATT_ADC, ADC_11db);

  loadConfig();
  resetTimers();

  // If the previous battery hit the critical threshold during a live match,
  // restore that exact game state but keep it frozen until the admin resumes.
  loadRecoveryState();

  dispA1.setBrightness(7, true);
  dispA2.setBrightness(7, true);
  dispB1.setBrightness(7, true);
  dispB2.setBrightness(7, true);
  updateDisplays();

  registerWebRoutes();
  startAdminWiFi();

  server.begin();

  ws.begin();
  ws.onEvent(onWsEvent);

  // Initialise battery filter with a first reading so it doesn't ramp from 0
  battVoltsRaw = readBattVoltsInstant();
  battVolts = battVoltsRaw;
  battPct = voltsToPct(battVolts);
  lowBatteryCritical = (battVoltsRaw < LOW_BATT_ENTER_V);
  lowBattLowCount = 0;
  lowBattHighCount = 0;

  lastTickMs = millis();
  lastBroadcastMs = 0;
}

void loop(){
  server.handleClient();
  ws.loop();

  const uint32_t now = millis();

  // ---- Non-blocking buzzer update ----
  // This runs before Identify mode because Identify returns early from loop().
  updateBuzzer(now);

  // ---- Smooth battery update ----
  static uint32_t lastBattMs = 0;
  if(now - lastBattMs >= BATT_UPDATE_MS){
    battVoltsRaw = readBattVoltsInstant();
    battVolts = battVolts + EMA_ALPHA * (battVoltsRaw - battVolts); // EMA smoothing
    battPct = voltsToPct(battVolts);

    // Protection uses the averaged INSTANT reading rather than the slow EMA.
    // EMA_ALPHA=0.05 is excellent for a stable UI, but using it for protection
    // could delay a real low-battery freeze by many seconds.
    if (!lowBatteryCritical) {
      if (battVoltsRaw < LOW_BATT_ENTER_V) {
        if (lowBattLowCount < LOW_BATT_CONFIRM_SAMPLES) lowBattLowCount++;
      } else {
        lowBattLowCount = 0;
      }

      if (lowBattLowCount >= LOW_BATT_CONFIRM_SAMPLES) {
        lowBatteryCritical = true;
        lowBattLowCount = 0;
        lowBattHighCount = 0;

        // Emergency action: stop game time and persist the current state.
        freezeAndSaveForLowBattery();
      }

    } else {
      if (battVoltsRaw > LOW_BATT_EXIT_V) {
        if (lowBattHighCount < LOW_BATT_CONFIRM_SAMPLES) lowBattHighCount++;
      } else {
        lowBattHighCount = 0;
      }

      if (lowBattHighCount >= LOW_BATT_CONFIRM_SAMPLES) {
        lowBatteryCritical = false;
        lowBattLowCount = 0;
        lowBattHighCount = 0;

        // Deliberately DO NOT auto-resume. The admin controls the restart.
      }
    }

    lastBattMs = now;
  }

  // ---- Battery bar button ----
  readDebounced(btnBt);
  static bool lastBat = false;
  bool batNow = isPressed(btnBt);
  if(batNow && !lastBat) triggerBarShow();
  lastBat = batNow;

  if(barActive){
    barShowBars(voltsToBars(battVolts), battVolts, now);
    if((int32_t)(now - barOffAtMs) >= 0){
      barActive = false;
      barAllOff();
    }
  } else {
    barAllOff();
  }

  // ---- Identify mode (stopped only): flash displays + LEDs ----
  if(identifyMode){
    if((int32_t)(now - identifyUntilMs) >= 0){
      identifyMode = false;
      dispA1.clear(); dispA2.clear(); dispB1.clear(); dispB2.clear();
      digitalWrite(PIN_LED_A, LOW);
      digitalWrite(PIN_LED_B, LOW);
    } else {
      bool blink = (now / 400) % 2;

      if(blink){
        dispA1.showNumberDec(1111, false);
        dispA2.showNumberDec(1111, false);
        dispB1.showNumberDec(2222, false);
        dispB2.showNumberDec(2222, false);
        digitalWrite(PIN_LED_A, HIGH);
        digitalWrite(PIN_LED_B, HIGH);
      } else {
        dispA1.clear(); dispA2.clear(); dispB1.clear(); dispB2.clear();
        digitalWrite(PIN_LED_A, LOW);
        digitalWrite(PIN_LED_B, LOW);
      }

      // keep UI live
      if(now - lastBroadcastMs >= 500){
        broadcastState();
        lastBroadcastMs = now;
      }
      return; // skip normal game logic during identify
    }
  }

  // ---- Read team buttons ----
  readDebounced(btnA);
  readDebounced(btnB);

  bool aHeld = isPressed(btnA);
  bool bHeld = isPressed(btnB);

  // ---- Manual physical start: hold BOTH team buttons for 5 seconds ----
  //
  // This is deliberately available only while the match is fully stopped.
  // A paused/recovered game cannot accidentally be replaced by a new match.
  if(!started && !manualStartSequenceActive && !lowBatteryCritical){
    if(aHeld && bHeld){
      if(bothButtonsHeldSinceMs == 0){
        bothButtonsHeldSinceMs = now;
      } else if(now - bothButtonsHeldSinceMs >= MANUAL_START_HOLD_MS){
        manualStartSequenceActive = true;
        manualStartMatchStarted = false;
        manualStartSequenceStartedMs = now;
        bothButtonsHeldSinceMs = 0;

        // A physical start is a deliberate new game start.
        clearRecoveryState();
        victoryPlayed = false;
        startManualStartCountdown();
      }
    } else {
      // Releasing either button before 5 seconds cancels the hold.
      bothButtonsHeldSinceMs = 0;
    }
  } else if(started || lowBatteryCritical){
    bothButtonsHeldSinceMs = 0;
  }

  // If the battery becomes critical during the audible countdown, abort it.
  if(manualStartSequenceActive && lowBatteryCritical){
    manualStartSequenceActive = false;
    manualStartMatchStarted = false;
    bothButtonsHeldSinceMs = 0;

    if(buzzerMode == BUZZER_MANUAL_START){
      stopBuzzer();
    }
  }

  // GO occurs at the beginning of the long third beep.
  if(manualStartSequenceActive &&
     !manualStartMatchStarted &&
     !lowBatteryCritical &&
     now - manualStartSequenceStartedMs >= MANUAL_START_GO_MS){

    started = true;
    paused = false;
    manualStartMatchStarted = true;
    lastTickMs = now;
  }

  // ---- Evaluate capture state ----
  evaluateCaptureState(aHeld, bHeld);

  // ---- Arcade button LED logic ----
  if(!started){
    digitalWrite(PIN_LED_A, LOW);
    digitalWrite(PIN_LED_B, LOW);
  } else if(captureState == ST_A){
    digitalWrite(PIN_LED_A, HIGH);
    digitalWrite(PIN_LED_B, LOW);
  } else if(captureState == ST_B){
    digitalWrite(PIN_LED_A, LOW);
    digitalWrite(PIN_LED_B, HIGH);
  } else if(captureState == ST_CONTESTED){
    digitalWrite(PIN_LED_A, HIGH);
    digitalWrite(PIN_LED_B, HIGH);
  } else {
    digitalWrite(PIN_LED_A, LOW);
    digitalWrite(PIN_LED_B, LOW);
  }

  // ---- Countdown tick ----
  uint32_t elapsedMs = now - lastTickMs;
  lastTickMs = now;

  if(started && !paused && captureState == ST_A){
    partialMsA += elapsedMs;

    while(partialMsA >= 1000UL && remainingA > 0){
      partialMsA -= 1000UL;
      remainingA--;

      if(remainingA == 0){
        partialMsA = 0;
        startVictoryChime();
      } else {
        startScoreChirp();
      }
    }
  }
  else if(started && !paused && captureState == ST_B){
    partialMsB += elapsedMs;

    while(partialMsB >= 1000UL && remainingB > 0){
      partialMsB -= 1000UL;
      remainingB--;

      if(remainingB == 0){
        partialMsB = 0;
        startVictoryChime();
      } else {
        startScoreChirp();
      }
    }
  }

  // ---- Update display ----
  // Gameplay is still whole-second MM:SS. 50 ms refresh is used so the
  // non-blocking winner spinner looks smooth without affecting timer accuracy.
  static uint32_t lastDispMs = 0;
  if(now - lastDispMs >= 50){
    updateDisplays();
    lastDispMs = now;
  }

  // ---- Broadcast to UI ----
  if(now - lastBroadcastMs >= 500){
    broadcastState();
    lastBroadcastMs = now;
  }

  delay(1);
}