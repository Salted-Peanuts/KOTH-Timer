//// ===== Active buzzer =====
// Keyestudio 3-pin ACTIVE buzzer on D13.
// Change to false only if the module turns on when D13 is LOW.
static const bool BUZZER_ACTIVE_HIGH = true;

// Short confirmation chirp for every real scored second.
static const uint32_t SCORE_CHIRP_MS = 35;

enum BuzzerMode : uint8_t { BUZZER_OFF, BUZZER_SCORE_CHIRP, BUZZER_VICTORY, BUZZER_LOW_BATT, BUZZER_MANUAL_START };

struct BuzzerPatternStep {
  bool on;
  uint16_t durationMs;
};

// Active buzzer victory pattern: BEEP - BEEP - BEEEEEEP
static const BuzzerPatternStep VICTORY_PATTERN[] = {
  {true,  100},
  {false, 100},
  {true,  100},
  {false, 150},
  {true,  700}
};
static const uint8_t VICTORY_PATTERN_COUNT =
  sizeof(VICTORY_PATTERN) / sizeof(VICTORY_PATTERN[0]);

// Manual physical start countdown:
//   BEEP ... BEEP ... BEEEEEEP
//
// The long beep begins 1440 ms after this pattern starts. That instant is GO.
static const BuzzerPatternStep MANUAL_START_PATTERN[] = {
  {true,  120},
  {false, 600},
  {true,  120},
  {false, 600},
  {true,  800}
};
static const uint8_t MANUAL_START_PATTERN_COUNT =
  sizeof(MANUAL_START_PATTERN) / sizeof(MANUAL_START_PATTERN[0]);

// Active buzzer has one fixed pitch, so the low-battery warning is a distinct
// rhythmic alarm rather than different musical notes:
//   BEEP-BEEP-BEEP ... pause ... repeat
static const BuzzerPatternStep LOW_BATT_PATTERN[] = {
  {true,   90},
  {false, 110},
  {true,   90},
  {false, 110},
  {true,   90},
  {false, 3500}
};
static const uint8_t LOW_BATT_PATTERN_COUNT =
  sizeof(LOW_BATT_PATTERN) / sizeof(LOW_BATT_PATTERN[0]);

static BuzzerMode buzzerMode = BUZZER_OFF;
static uint8_t buzzerPatternStep = 0;
static uint32_t buzzerDeadlineMs = 0;
static bool victoryPlayed = false;

static void buzzerSet(bool on) {
  const int activeLevel = BUZZER_ACTIVE_HIGH ? HIGH : LOW;
  const int inactiveLevel = BUZZER_ACTIVE_HIGH ? LOW : HIGH;
  digitalWrite(PIN_BUZZER, on ? activeLevel : inactiveLevel);
}

static void stopBuzzer() {
  buzzerSet(false);
  buzzerMode = BUZZER_OFF;
  buzzerPatternStep = 0;
  buzzerDeadlineMs = 0;
}

static void rearmVictorySound() {
  victoryPlayed = false;
  stopBuzzer();
}

static void startScoreChirp() {
  if (buzzerMode == BUZZER_VICTORY ||
      buzzerMode == BUZZER_LOW_BATT ||
      buzzerMode == BUZZER_MANUAL_START) return;
  buzzerSet(true);
  buzzerMode = BUZZER_SCORE_CHIRP;
  buzzerDeadlineMs = millis() + SCORE_CHIRP_MS;
}

static void startVictoryChime() {
  if (victoryPlayed) return;
  if (lowBatteryCritical || buzzerMode == BUZZER_LOW_BATT) return;
  victoryPlayed = true;
  buzzerMode = BUZZER_VICTORY;
  buzzerPatternStep = 0;
  buzzerSet(VICTORY_PATTERN[0].on);
  buzzerDeadlineMs = millis() + VICTORY_PATTERN[0].durationMs;
}

static void startManualStartCountdown() {
  if (lowBatteryCritical) return;

  // Don't allow another sound to trample the physical-start countdown.
  stopBuzzer();

  buzzerMode = BUZZER_MANUAL_START;
  buzzerPatternStep = 0;
  buzzerSet(MANUAL_START_PATTERN[0].on);
  buzzerDeadlineMs = millis() + MANUAL_START_PATTERN[0].durationMs;
}

static void startLowBatteryAlarm() {
  // Critical battery warning has priority over score chirps.
  if (buzzerMode == BUZZER_LOW_BATT) return;

  buzzerMode = BUZZER_LOW_BATT;
  buzzerPatternStep = 0;
  buzzerSet(LOW_BATT_PATTERN[0].on);
  buzzerDeadlineMs = millis() + LOW_BATT_PATTERN[0].durationMs;
}

static void updateBuzzer(uint32_t now) {
  // Start/stop the repeating critical-battery alarm as required.
  if (lowBatteryCritical) {
    if (buzzerMode != BUZZER_LOW_BATT && buzzerMode != BUZZER_VICTORY) {
      startLowBatteryAlarm();
    }
  } else if (buzzerMode == BUZZER_LOW_BATT) {
    stopBuzzer();
  }

  if (buzzerMode == BUZZER_OFF) return;
  if ((int32_t)(now - buzzerDeadlineMs) < 0) return;

  if (buzzerMode == BUZZER_SCORE_CHIRP) {
    stopBuzzer();
    return;
  }

  if (buzzerMode == BUZZER_LOW_BATT) {
    buzzerPatternStep++;
    if (buzzerPatternStep >= LOW_BATT_PATTERN_COUNT) {
      buzzerPatternStep = 0; // repeat alarm while battery remains critical
    }

    buzzerSet(LOW_BATT_PATTERN[buzzerPatternStep].on);
    buzzerDeadlineMs = now + LOW_BATT_PATTERN[buzzerPatternStep].durationMs;
    return;
  }

  if (buzzerMode == BUZZER_MANUAL_START) {
    buzzerPatternStep++;

    if (buzzerPatternStep >= MANUAL_START_PATTERN_COUNT) {
      stopBuzzer();
      manualStartSequenceActive = false;
      manualStartMatchStarted = false;
      return;
    }

    buzzerSet(MANUAL_START_PATTERN[buzzerPatternStep].on);
    buzzerDeadlineMs = now + MANUAL_START_PATTERN[buzzerPatternStep].durationMs;
    return;
  }

  // Victory pattern
  buzzerPatternStep++;
  if (buzzerPatternStep >= VICTORY_PATTERN_COUNT) {
    stopBuzzer();
    return;
  }

  buzzerSet(VICTORY_PATTERN[buzzerPatternStep].on);
  buzzerDeadlineMs = now + VICTORY_PATTERN[buzzerPatternStep].durationMs;
}

//// ===== Helpers =====
static String formatMMSS(int32_t s) {
  if (s < 0) s = 0;
  int32_t m = s / 60;
  int32_t r = s % 60;
  char buf[8];
  snprintf(buf, sizeof(buf), "%02ld:%02ld", (long)m, (long)r);
  return String(buf);
}
static uint16_t encodeMMSS(int32_t s) {
  if (s < 0) s = 0;
  int mm = (int)(s / 60);
  int ss = (int)(s % 60);
  return (uint16_t)(mm * 100 + ss);
}
static void resetTimers() {
  remainingA = (int32_t)durationSec;
  remainingB = (int32_t)durationSec;
  partialMsA = 0;
  partialMsB = 0;
}

static const int32_t MAX_REMAINING_SEC = (99 * 60) + 59; // TM1637 MM:SS practical max

static int32_t clampRemainingTime(int32_t seconds) {
  if (seconds < 0) return 0;
  if (seconds > MAX_REMAINING_SEC) return MAX_REMAINING_SEC;
  return seconds;
}

static void adjustTeamTime(const String &team, int32_t deltaSec) {
  if (team == "A") {
    remainingA = clampRemainingTime(remainingA + deltaSec);
    partialMsA = 0;
  } else if (team == "B") {
    remainingB = clampRemainingTime(remainingB + deltaSec);
    partialMsB = 0;
  }

  if (remainingA > 0 && remainingB > 0) {
    rearmVictorySound();
  }

  // Prevent an immediate time jump straight after a referee adjustment.
  lastTickMs = millis();

  updateDisplays();
}

static bool isHexDigitChar(char c) {
  return (c >= '0' && c <= '9') ||
         (c >= 'a' && c <= 'f') ||
         (c >= 'A' && c <= 'F');
}

static bool isValidHtmlColor(const String &value) {
  if (value.length() != 7 || value[0] != '#') return false;

  for (size_t i = 1; i < 7; i++) {
    if (!isHexDigitChar(value[i])) return false;
  }
  return true;
}

static void loadConfig() {
  prefs.begin("koth", true);
  durationSec = prefs.getUInt("dur", 5 * 60);
  colorA = prefs.getString("colA", "#ff3333");
  colorB = prefs.getString("colB", "#3333ff");
  prefs.end();

  if (!isValidHtmlColor(colorA)) colorA = "#ff3333";
  if (!isValidHtmlColor(colorB)) colorB = "#3333ff";

  if (durationSec < 60) durationSec = 60;
  if (durationSec > 60 * 60) durationSec = 60 * 60;
}
static void saveConfig() {
  prefs.begin("koth", false);
  prefs.putUInt("dur", durationSec);
  prefs.putString("colA", colorA);
  prefs.putString("colB", colorB);
  prefs.end();
}


// ===== Emergency low-battery game recovery =====
//
// This snapshot is intentionally written ONLY when the battery first crosses
// into the critical zone (or when a ref edits a recovered paused game).
// It is not written every second, avoiding unnecessary flash wear.
static void saveRecoveryState() {
  if (!started || remainingA <= 0 || remainingB <= 0) return;

  prefs.begin("koth", false);
  prefs.putInt("recA", remainingA);
  prefs.putInt("recB", remainingB);
  prefs.putUInt("recPA", partialMsA);
  prefs.putUInt("recPB", partialMsB);
  prefs.putBool("recValid", true);
  prefs.end();

  recoverySnapshotValid = true;
}

static void clearRecoveryState() {
  prefs.begin("koth", false);
  prefs.putBool("recValid", false);
  prefs.end();

  recoverySnapshotValid = false;
}

static bool loadRecoveryState() {
  prefs.begin("koth", true);
  bool valid = prefs.getBool("recValid", false);

  if (!valid) {
    prefs.end();
    recoverySnapshotValid = false;
    return false;
  }

  int32_t savedA = prefs.getInt("recA", -1);
  int32_t savedB = prefs.getInt("recB", -1);
  uint32_t savedPA = prefs.getUInt("recPA", 0);
  uint32_t savedPB = prefs.getUInt("recPB", 0);
  prefs.end();

  // Reject a corrupt/stale snapshot rather than restoring nonsense.
  if (savedA <= 0 || savedB <= 0 ||
      savedA > MAX_REMAINING_SEC || savedB > MAX_REMAINING_SEC ||
      savedPA >= 1000UL || savedPB >= 1000UL) {
    clearRecoveryState();
    return false;
  }

  remainingA = savedA;
  remainingB = savedB;
  partialMsA = savedPA;
  partialMsB = savedPB;

  // A recovered game ALWAYS boots frozen. The admin must explicitly Resume.
  started = true;
  paused = true;
  captureState = ST_IDLE;
  recoverySnapshotValid = true;
  return true;
}

static void freezeAndSaveForLowBattery() {
  // Only preserve an actual in-progress match.
  if (!started || remainingA <= 0 || remainingB <= 0) return;

  // Freeze scoring immediately before touching flash.
  paused = true;
  captureState = ST_IDLE;
  lastTickMs = millis();

  saveRecoveryState();
}

// Normal MM:SS display.
// Gameplay stays on the original whole-second timer format.
static void showTimeOn(TM1637Display &d, int32_t seconds, uint8_t separatorMask) {
  uint16_t v = encodeMMSS(seconds);
  bool leadingZero = (seconds >= 600); // original gameplay display behaviour
  d.showNumberDecEx(v, separatorMask, leadingZero);
}

// ===== Winner animation =====
//
// Each TM1637 is treated as its own self-contained celebration display.
// The six outside segments rotate around every digit like four little spinners.
//
// Sequence:
//   1) Three full spinner rotations
//   2) 00:00 blinks for ~2.4 seconds
//   3) Repeat until reset
//
// No 8888 flash is used.

static const uint8_t WIN_SPINNER_SEGMENTS[6] = {
  0x01, // A - top
  0x02, // B - upper right
  0x04, // C - lower right
  0x08, // D - bottom
  0x10, // E - lower left
  0x20  // F - upper left
};

static const uint32_t WIN_SPINNER_STEP_MS = 100;
static const uint8_t  WIN_SPINNER_ROTATIONS = 3;
static const uint32_t WIN_SPINNER_DURATION_MS =
  6UL * WIN_SPINNER_ROTATIONS * WIN_SPINNER_STEP_MS; // 1800 ms

static const uint32_t WIN_ZERO_BLINK_STEP_MS = 300;
static const uint8_t  WIN_ZERO_BLINK_PHASES = 8; // 4 on + 4 off
static const uint32_t WIN_ZERO_BLINK_DURATION_MS =
  WIN_ZERO_BLINK_STEP_MS * WIN_ZERO_BLINK_PHASES; // 2400 ms

static const uint32_t WIN_ANIM_CYCLE_MS =
  WIN_SPINNER_DURATION_MS + WIN_ZERO_BLINK_DURATION_MS;

static uint8_t victoryDisplayState = 0; // 0 none, 1 A, 2 B, 3 draw
static uint32_t victoryDisplayStartMs = 0;

static void showVictorySpinner(TM1637Display &d) {
  uint8_t step = (uint8_t)((millis() - victoryDisplayStartMs) / WIN_SPINNER_STEP_MS);
  step %= 6;

  uint8_t segs[4] = {
    WIN_SPINNER_SEGMENTS[step],
    WIN_SPINNER_SEGMENTS[step],
    WIN_SPINNER_SEGMENTS[step],
    WIN_SPINNER_SEGMENTS[step]
  };

  d.setSegments(segs);
}

static void showVictoryZeroBlink(TM1637Display &d, uint8_t separatorMask, uint32_t phaseElapsedMs) {
  uint8_t phase = (uint8_t)(phaseElapsedMs / WIN_ZERO_BLINK_STEP_MS);

  if ((phase % 2U) == 0U) {
    // Force all four digits so the winner clearly sees 00:00,
    // rather than the normal gameplay leading-zero suppression.
    d.showNumberDecEx(0, separatorMask, true);
  } else {
    d.clear();
  }
}

static void showVictoryAnimation(TM1637Display &d1, TM1637Display &d2,
                                 uint8_t separatorMask, uint32_t elapsedMs) {
  uint32_t cycleMs = elapsedMs % WIN_ANIM_CYCLE_MS;

  if (cycleMs < WIN_SPINNER_DURATION_MS) {
    showVictorySpinner(d1);
    showVictorySpinner(d2);
    return;
  }

  uint32_t blinkElapsed = cycleMs - WIN_SPINNER_DURATION_MS;
  showVictoryZeroBlink(d1, separatorMask, blinkElapsed);
  showVictoryZeroBlink(d2, separatorMask, blinkElapsed);
}

static void showTeamTime(TM1637Display &d1, TM1637Display &d2,
                         int32_t wholeSeconds,
                         uint8_t separatorMask) {
  showTimeOn(d1, wholeSeconds, separatorMask);
  showTimeOn(d2, wholeSeconds, separatorMask);
}

static void showLowBatteryText(TM1637Display &d, bool visible) {
  if (!visible) {
    d.clear();
    return;
  }

  // Raw 7-segment characters:
  // L = segments D+E+F = 0x38
  // O = same segments as digit 0 = 0x3F
  //
  // Bit 7 on the second digit drives the centre separator on these clock-style
  // TM1637 modules, giving the requested LO:LO appearance.
  uint8_t segs[4] = {
    0x38,        // L
    0x3F | 0x80, // O + centre separator
    0x38,        // L
    0x3F         // O
  };
  d.setSegments(segs);
}

static void updateDisplays() {
  const uint8_t separatorMask = 0b01000000;

  // Critical battery warning overrides all normal/winner display content.
  // All four TM1637 modules flash LO:LO together.
  if (lowBatteryCritical) {
    const bool lowBlinkOn = ((millis() / 450UL) % 2UL) == 0;
    showLowBatteryText(dispA1, lowBlinkOn);
    showLowBatteryText(dispA2, lowBlinkOn);
    showLowBatteryText(dispB1, lowBlinkOn);
    showLowBatteryText(dispB2, lowBlinkOn);
    return;
  }

  const bool aWon = (remainingA <= 0 && remainingB > 0);
  const bool bWon = (remainingB <= 0 && remainingA > 0);
  const bool draw = (remainingA <= 0 && remainingB <= 0);

  uint8_t newVictoryState = 0;
  if (draw) newVictoryState = 3;
  else if (aWon) newVictoryState = 1;
  else if (bWon) newVictoryState = 2;

  // Start the celebration from the beginning exactly when a winner appears.
  // If a referee adjustment removes the win condition, the animation rearms.
  if (newVictoryState != victoryDisplayState) {
    victoryDisplayState = newVictoryState;
    victoryDisplayStartMs = millis();
  }

  if (newVictoryState == 0) {
    showTeamTime(dispA1, dispA2, remainingA, separatorMask);    showTeamTime(dispB1, dispB2, remainingB, separatorMask);
    return;
  }

  uint32_t elapsedMs = millis() - victoryDisplayStartMs;

  if (aWon) {
    showVictoryAnimation(dispA1, dispA2, separatorMask, elapsedMs);
    showTeamTime(dispB1, dispB2, remainingB, separatorMask);
  } else if (bWon) {
    showTeamTime(dispA1, dispA2, remainingA, separatorMask);
    showVictoryAnimation(dispB1, dispB2, separatorMask, elapsedMs);
  } else {
    // Draw: both teams celebrate independently.
    showVictoryAnimation(dispA1, dispA2, separatorMask, elapsedMs);
    showVictoryAnimation(dispB1, dispB2, separatorMask, elapsedMs);
  }
}

// Winner string used by UI
static String winnerString() {
  // Match ends when either team reaches 0
  if (remainingA <= 0 && remainingB <= 0) return "DRAW";
  if (remainingA <= 0) return "TEAM_A";
  if (remainingB <= 0) return "TEAM_B";
  return "";
}

// Battery conversion using the ESP32's calibrated ADC millivolt reading.
//
// The two calibration points at the top of this file were taken from the
// firmware's own /state "ba0" value and matched against battery-terminal
// voltage measured under load. Keeping both points on the same ADC scale
// avoids mixing multimeter A0 readings with firmware ADC readings.
static float readBattVoltsInstant() {
  uint32_t sumMv = 0;

  for (int i = 0; i < BATT_SAMPLES; i++) {
    sumMv += analogReadMilliVolts(PIN_BATT_ADC);
    delay(2);
  }

  float v_adc = ((float)sumMv / (float)BATT_SAMPLES) / 1000.0f;
  battA0Volts = v_adc;

  const float slope =
    (CAL_BATT_HIGH - CAL_BATT_LOW) / (CAL_A0_HIGH - CAL_A0_LOW);

  float v_batt =
    CAL_BATT_LOW + ((v_adc - CAL_A0_LOW) * slope);

  v_batt = (v_batt * BATT_GAIN) + BATT_OFFSET;

  if (v_batt > 4.25f) v_batt = 4.25f;
  if (v_batt < 3.00f) v_batt = 3.00f;

  return v_batt;
}

static int voltsToPct(float v) {
  // Generic 1S Li-ion style battery gauge.
  // This is only an approximate state-of-charge style display.
  if (v >= 4.20f) return 100;
  if (v <= 3.30f) return 0;

  if (v >= 4.00f) return (int)(80 + (v - 4.00f) * (20.0f / 0.20f));
  if (v >= 3.85f) return (int)(55 + (v - 3.85f) * (25.0f / 0.15f));
  if (v >= 3.70f) return (int)(30 + (v - 3.70f) * (25.0f / 0.15f));
  if (v >= 3.50f) return (int)(10 + (v - 3.50f) * (20.0f / 0.20f));

  return (int)((v - 3.30f) * (10.0f / 0.20f));
}

static int voltsToBars(float v) {
  // Even 0.15 V steps across the useful steady-bar range.
  //
  // 1 bar  : 3.45 V to <3.60 V
  // 2 bars : 3.60 V to <3.75 V
  // 3 bars : 3.75 V to <3.90 V
  // 4 bars : 3.90 V to <4.05 V
  // 5 bars : 4.05 V and above
  //
  // Below 3.45 V, barShowBars() flashes the single red bar.
  if (v >= 4.05f) return 5;
  if (v >= 3.90f) return 4;
  if (v >= 3.75f) return 3;
  if (v >= 3.60f) return 2;
  if (v >= 3.45f) return 1;
  return 0;
}

// Bargraph outputs: HIGH=ON, LOW=OFF (your wiring)
static void barAllOff() {
  digitalWrite(PIN_BAR_RED, LOW);
  digitalWrite(PIN_BAR_YELLOW, LOW);
  digitalWrite(PIN_BAR_G1, LOW);
  digitalWrite(PIN_BAR_G2, LOW);
  digitalWrite(PIN_BAR_G3, LOW);
}
static void barShowBars(int bars, float v, uint32_t now) {
  // Below 3.45V, don't show an empty indicator. Flash the final red bar instead.
  if (v < 3.45f) {
    bool flashOn = ((now / 350UL) % 2UL) == 0;
    digitalWrite(PIN_BAR_RED,    flashOn ? HIGH : LOW);
    digitalWrite(PIN_BAR_YELLOW, LOW);
    digitalWrite(PIN_BAR_G1,     LOW);
    digitalWrite(PIN_BAR_G2,     LOW);
    digitalWrite(PIN_BAR_G3,     LOW);
    return;
  }

  digitalWrite(PIN_BAR_RED,    (bars >= 1) ? HIGH : LOW);
  digitalWrite(PIN_BAR_YELLOW, (bars >= 2) ? HIGH : LOW);
  digitalWrite(PIN_BAR_G1,     (bars >= 3) ? HIGH : LOW);
  digitalWrite(PIN_BAR_G2,     (bars >= 4) ? HIGH : LOW);
  digitalWrite(PIN_BAR_G3,     (bars >= 5) ? HIGH : LOW);
}
static void triggerBarShow() {
  barActive = true;
  barOffAtMs = millis() + BAR_SHOW_MS;
}

static void evaluateCaptureState(bool aHeld, bool bHeld) {
  if (remainingA <= 0 || remainingB <= 0) { captureState = ST_DONE; return; }
  if (!started) { captureState = ST_READY; return; }
  if (paused) { captureState = ST_IDLE; return; }

  if (aHeld && !bHeld) captureState = ST_A;
  else if (bHeld && !aHeld) captureState = ST_B;
  else if (aHeld && bHeld) captureState = ST_CONTESTED;
  else captureState = ST_IDLE;
}

static const char* stateToStr(CaptureState s) {
  switch (s) {
    case ST_READY:     return "READY";
    case ST_IDLE:      return "IDLE";
    case ST_A:         return "TEAM_A";
    case ST_B:         return "TEAM_B";
    case ST_CONTESTED: return "CONTESTED";
    case ST_DONE:      return "DONE";
    default:           return "IDLE";
  }
}

static String makeStateJson() {
  String win = winnerString();

  String json;
  json.reserve(256);
  json = "{";
  json += "\"a\":\"" + formatMMSS(remainingA) + "\",";
  json += "\"b\":\"" + formatMMSS(remainingB) + "\",";
  json += "\"status\":\"" + String(stateToStr(captureState)) + "\",";
  json += "\"started\":" + String(started ? "true" : "false") + ",";
  json += "\"paused\":" + String(paused ? "true" : "false") + ",";
  json += "\"lowBatt\":" + String(lowBatteryCritical ? "true" : "false") + ",";
  json += "\"recovery\":" + String(recoverySnapshotValid ? "true" : "false") + ",";
  json += "\"dur\":" + String(durationSec) + ",";
  json += "\"colA\":\"" + colorA + "\",";
  json += "\"colB\":\"" + colorB + "\",";
  json += "\"bv\":" + String(battVolts, 2) + ",";
  json += "\"ba0\":" + String(battA0Volts, 2) + ",";
  json += "\"bp\":" + String(battPct) + ",";
  json += "\"identify\":" + String(identifyMode ? "true" : "false") + ",";
  json += "\"winner\":\"" + win + "\"";
  json += "}";
  return json;
}

static void broadcastState() {
  String payload = makeStateJson(); // lvalue needed by WebSockets 2.7.2
  ws.broadcastTXT(payload);
}


